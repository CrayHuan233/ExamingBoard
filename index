/* =========================================================
   【新增】自定义科目持久化 + 自定义科目删除管理（DOM已写在HTML内，不再JS注入）
   ========================================================= */
const CUSTOM_SUBJECT_STORE_KEY = "exam_custom_subjects_v1";
const persistCheck = document.getElementById("persistSubjectCheck");
const delSelect = document.getElementById("delCustomSubjectSelect");

// 读取本地存储的自定义科目集合
function getStoredCustomSubjects() {
  try {
    const raw = localStorage.getItem(CUSTOM_SUBJECT_STORE_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch {
    return [];
  }
}
function saveStoredCustomSubjects(arr) {
  localStorage.setItem(CUSTOM_SUBJECT_STORE_KEY, JSON.stringify(arr));
}

// 渲染删除下拉菜单
function refreshDelSubjectSelect() {
  const list = getStoredCustomSubjects();
  delSelect.innerHTML = "";
  // 逐个添加已保存科目
  list.forEach(name => {
    const mi = document.createElement('mdui-menu-item');
    mi.value = name;
    mi.textContent = name;
    delSelect.appendChild(mi);
  });
  // 清除全部选项
  const clearAllItem = document.createElement('mdui-menu-item');
  clearAllItem.value = "__CLEAR_ALL__";
  clearAllItem.textContent = "清除所有自定义科目";
  delSelect.appendChild(clearAllItem);
  // 无自定义科目时，清除全部置灰
  clearAllItem.disabled = list.length === 0;
}

// 监听删除select变化
delSelect.addEventListener('change', () => {
  const val = delSelect.value;
  if (!val) return;
  const stored = getStoredCustomSubjects();
  if (val === "__CLEAR_ALL__") {
    saveStoredCustomSubjects([]);
    // 清理主select里所有__custom_value__条目
    subjectSelect.querySelectorAll('mdui-menu-item[value="__custom_value__"]').forEach(el => el.remove());
    subjectSelect.value = lastSubjectValue;
    mdui.snackbar({ message: "已清空全部保存的自定义科目" });
  } else {
    const newList = stored.filter(s => s !== val);
    saveStoredCustomSubjects(newList);
    // 移除主下拉里对应的自定义选项
    subjectSelect.querySelectorAll('mdui-menu-item[value="__custom_value__"]').forEach(el => {
      if(el.textContent.trim() === val.trim()) el.remove();
    });
    mdui.snackbar({ message: `已删除科目：${val}` });
  }
  delSelect.value = "";
  refreshDelSubjectSelect();
});

// 打开dialog时刷新下拉列表
customDialog.addEventListener('open', () => {
  refreshDelSubjectSelect();
});

// 覆盖原有确认按钮事件
customSubjectConfirm.onclick = null;
customSubjectConfirm.addEventListener('click', () => {
  const name = (customSubjectInput.value || '').trim();
  if (!name) {
    mdui.snackbar({ message: '请输入科目名称' });
    return;
  }
  pendingCustomSubject = name;
  // 如果勾选保存，写入localStorage（去重）
  if (persistCheck.checked) {
    let stored = getStoredCustomSubjects();
    if (!stored.includes(name)) {
      stored.push(name);
      saveStoredCustomSubjects(stored);
    }
  }
  customDialog.open = false;
});

// Dialog关闭回调
customDialog.removeEventListener('closed', function(){});
customDialog.addEventListener('closed', () => {
  // 原有逻辑：临时自定义科目
  if (pendingCustomSubject) {
    selectedSubject = pendingCustomSubject;
    subjectPickerBtn.textContent = '科目：' + pendingCustomSubject;
    let customItem = subjectSelect.querySelector('mdui-menu-item[value="__custom_value__"]');
    if (!customItem) {
      customItem = document.createElement('mdui-menu-item');
      customItem.setAttribute('value', '__custom_value__');
      const customOption = subjectSelect.querySelector('mdui-menu-item[value="__custom__"]');
      subjectSelect.insertBefore(customItem, customOption);
    }
    customItem.textContent = pendingCustomSubject;
    subjectSelect.value = '__custom_value__';
    lastSubjectValue = '__custom_value__';
    pendingCustomSubject = null;
  } else {
    subjectSelect.value = lastSubjectValue;
  }

  // 关闭Dialog后，把localStorage里面所有持久化科目批量同步进主下拉（去重）
  const stored = getStoredCustomSubjects();
  const customMarkerOption = subjectSelect.querySelector('mdui-menu-item[value="__custom__"]');
  stored.forEach(subName => {
    const exist = Array.from(subjectSelect.querySelectorAll('mdui-menu-item[value="__custom_value__"]')).some(el => el.textContent.trim() === subName.trim());
    if (!exist) {
      const newMi = document.createElement('mdui-menu-item');
      newMi.value = "__custom_value__";
      newMi.textContent = subName;
      subjectSelect.insertBefore(newMi, customMarkerOption);
    }
  });

  // 关闭弹窗重置控件状态
  customSubjectInput.value = "";
  persistCheck.checked = false;
});

// 页面初始化加载持久化科目
function loadPersistSubjectOnBoot() {
  const stored = getStoredCustomSubjects();
  const customMarkerOption = subjectSelect.querySelector('mdui-menu-item[value="__custom__"]');
  stored.forEach(subName => {
    const exist = Array.from(subjectSelect.querySelectorAll('mdui-menu-item[value="__custom_value__"]')).some(el => el.textContent.trim() === subName.trim());
    if (!exist) {
      const newMi = document.createElement('mdui-menu-item');
      newMi.value = "__custom_value__";
      newMi.textContent = subName;
      subjectSelect.insertBefore(newMi, customMarkerOption);
    }
  });
}
loadPersistSubjectOnBoot();




/* =========================================================
   定时更新
   ========================================================= */
setInterval(() => {
  updateClock();
  render();
}, 1000);
function initClockFace() {
  const ticks = document.getElementById('clockTicks');
  if (!ticks) return;
  for (let i = 0; i < 60; i++) {
    const angle = i * 6 * Math.PI / 180;
    const major = i % 5 === 0;
    const outer = 174;
    const inner = major ? 153 : 166;
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', 200 + Math.sin(angle) * inner);
    line.setAttribute('y1', 200 - Math.cos(angle) * inner);
    line.setAttribute('x2', 200 + Math.sin(angle) * outer);
    line.setAttribute('y2', 200 - Math.cos(angle) * outer);
    line.setAttribute('class', 'clock-tick' + (major ? ' major' : ''));
    ticks.appendChild(line);
  }
  const numbers = document.getElementById('clockNumbers');
  for (let n = 1; n <= 12; n++) {
    const angle = n * 30 * Math.PI / 180;
    const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    text.setAttribute('x', 200 + Math.sin(angle) * 132);
    text.setAttribute('y', 200 - Math.cos(angle) * 132);
    text.setAttribute('class', 'clock-number');
    text.textContent = n;
    numbers.appendChild(text);
  }
}
initClockFace();
updateClock();
render();
scheduleCountdownRender();
function animateClock() {
  updateClock();
  requestAnimationFrame(animateClock);
}
animateClock();

if (window.customElements && customElements.whenDefined) {
  Promise.allSettled([
    customElements.whenDefined('mdui-button'),
    customElements.whenDefined('mdui-button-icon'),
    customElements.whenDefined('mdui-text-field'),
    customElements.whenDefined('mdui-select'),
    customElements.whenDefined('mdui-menu-item'),
    customElements.whenDefined('mdui-dialog'),
    customElements.whenDefined('mdui-top-app-bar')
  ]).then(() => {
    requestAnimationFrame(() => render());
  });
}
