<script>
/* =========================================================
   主题色
   ========================================================= */
(function() {
  if (window.mdui && typeof mdui.setColorScheme === 'function') {
    mdui.setColorScheme('#036C6D');
  }
})();

/* =========================================================
   深浅色切换
   ========================================================= */
(function initThemeToggle() {
  const btn = document.getElementById('themeToggleBtn');
  const root = document.documentElement;
  const THEME_KEY = 'exam-clock-theme';

  function applyTheme(theme) {
    root.classList.remove('mdui-theme-auto', 'mdui-theme-light', 'mdui-theme-dark');
    if (theme === 'light' || theme === 'dark') {
      root.classList.add('mdui-theme-' + theme);
      btn.setAttribute('icon', theme === 'dark' ? 'light_mode' : 'dark_mode');
    } else {
      root.classList.add('mdui-theme-auto');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      btn.setAttribute('icon', prefersDark ? 'light_mode' : 'dark_mode');
    }
  }

  function getSaved() {
    try { return localStorage.getItem(THEME_KEY) || 'auto'; } catch { return 'auto'; }
  }

  applyTheme(getSaved());

  btn.addEventListener('click', () => {
    const cur = getSaved();
    let next;
    if (cur === 'auto') {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      next = prefersDark ? 'light' : 'dark';
    } else if (cur === 'dark') {
      next = 'light';
    } else {
      next = 'dark';
    }
    try { localStorage.setItem(THEME_KEY, next); } catch {}
    applyTheme(next);
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (getSaved() === 'auto') applyTheme('auto');
  });
})();

/* =========================================================
   考试数据逻辑
   ========================================================= */
const KEY = 'exam_schedule_v2';

function pad(n) { return String(n).padStart(2, '0'); }

function getExams() {
  try {
    const stored = JSON.parse(localStorage.getItem(KEY));
    return Array.isArray(stored) ? stored : [];
  }
  catch { return []; }
}
function saveExams(list) {
  localStorage.setItem(KEY, JSON.stringify(list));
}

function fmtDT(iso) {
  const d = new Date(iso);
  return d.getFullYear() + '/' + pad(d.getMonth()+1) + '/' + pad(d.getDate())
    + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
}

function escapeHtml(s) {
  const d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}

function getPhase(startMs, endMs, now) {
  if (now < startMs) return 'waiting';
  if (now < endMs) return 'running';
  return 'ended';
}

function diffParts(absDiff) {
  let d = Math.max(0, Number.isFinite(absDiff) ? absDiff : 0);
  const hrs  = Math.floor(d / 3600000);  d -= hrs  * 3600000;
  const mins = Math.floor(d / 60000);    d -= mins * 60000;
  const secs = Math.floor(d / 1000);
  return { hrs, mins, secs };
}

function getExamProgress(exam, now) {
  const phase = getPhase(exam.startMs, exam.endMs, now);
  if (phase === 'waiting') {
    const parts = diffParts(exam.startMs - now);
    return {
      phase,
      parts,
      label: '距离考试开始',
      status: '倒计时中',
      urgent: parts.hrs === 0 && parts.mins < 30,
    };
  }
  if (phase === 'running') {
    return {
      phase,
      parts: diffParts(now - exam.startMs),
      label: '考试进行中',
      status: '已开始，计时中',
      urgent: false,
    };
  }
  return {
    phase,
    parts: diffParts(exam.endMs - exam.startMs),
    label: '考试已结束',
    status: '已结束',
    urgent: false,
  };
}

function createExamSnapshot(now) {
  const exams = getExams()
    .filter(ex => ex && typeof ex === 'object')
    .map(ex => ({
      ...ex,
      id: ex.id === undefined || ex.id === null ? '' : String(ex.id),
      startMs: new Date(ex.start).getTime(),
      endMs: new Date(ex.end).getTime(),
    }))
    .filter(ex => ex.id.length > 0
      && typeof ex.name === 'string'
      && ex.name.trim().length > 0
      && typeof ex.start === 'string'
      && typeof ex.end === 'string'
      && Number.isFinite(ex.startMs)
      && Number.isFinite(ex.endMs)
      && ex.endMs > ex.startMs)
    .sort((a, b) => a.startMs - b.startMs || a.endMs - b.endMs);

  const running = exams.find(ex => getPhase(ex.startMs, ex.endMs, now) === 'running');
  const upcoming = exams.find(ex => getPhase(ex.startMs, ex.endMs, now) === 'waiting');
  const mostRecentlyEnded = exams
    .filter(ex => getPhase(ex.startMs, ex.endMs, now) === 'ended')
    .sort((a, b) => b.endMs - a.endMs)[0];
  const target = running || upcoming || mostRecentlyEnded || null;

  return {
    exams,
    target,
    progress: target ? getExamProgress(target, now) : null,
  };
}

/* =========================================================
   渲染主页时钟 + 倒计时
   ========================================================= */
function updateClock() {
  const now = new Date();
  const seconds = now.getSeconds() + now.getMilliseconds() / 1000;
  const minutes = now.getMinutes() + seconds / 60;
  const hours = (now.getHours() % 12) + minutes / 60;

  const hourHand = document.getElementById('hourHand');
  const minuteHand = document.getElementById('minuteHand');
  const secondHand = document.getElementById('secondHand');
  const clockDate = document.getElementById('clockDate');
  if (hourHand) hourHand.setAttribute('transform', 'rotate(' + (hours * 30) + ' 200 200)');
  if (minuteHand) minuteHand.setAttribute('transform', 'rotate(' + (minutes * 6) + ' 200 200)');
  if (secondHand) secondHand.setAttribute('transform', 'rotate(' + (seconds * 6) + ' 200 200)');
  if (clockDate) clockDate.textContent =
    now.getFullYear() + '/' + pad(now.getMonth()+1) + '/' + pad(now.getDate())
    + ' ' + ['日','一','二','三','四','五','六'][now.getDay()];
}

function renderMain(snapshot) {
  const mainName  = document.getElementById('mainName');
  const mainLabel = document.getElementById('mainLabel');
  const status    = document.getElementById('status');
  const cdB = document.getElementById('cdB');
  const cdC = document.getElementById('cdC');
  const cdD = document.getElementById('cdD');
  const cdBT = document.getElementById('cdBT');
  const cdCT = document.getElementById('cdCT');
  const cdDT = document.getElementById('cdDT');
  if (!mainName) return;

  if (!snapshot.target) {
    mainName.textContent = '暂无考试安排';
    mainName.className = 'main-name waiting';
    mainLabel.textContent = '当前状态';
    status.textContent = '请添加考试';
    status.className = 'status';
    cdB.textContent = '00'; cdC.textContent = '00'; cdD.textContent = '00';
    cdBT.textContent = '时';
    cdCT.textContent = '分'; cdDT.textContent = '秒';
    [cdB, cdC, cdD].forEach(e => e.className = 'cd-num');
    return;
  }

  const { target, progress } = snapshot;
  const { phase, parts, label, status: statusText, urgent } = progress;
  mainName.textContent = target.name;
  mainName.className = 'main-name ' + phase;
  mainLabel.textContent = label;
  status.textContent = statusText;
  status.className = 'status ' + phase;
  cdB.textContent = pad(parts.hrs);
  cdC.textContent = pad(parts.mins);
  cdD.textContent = pad(parts.secs);
  cdBT.textContent = '时';
  cdCT.textContent = '分';
  cdDT.textContent = '秒';
  [cdB, cdC, cdD].forEach(e => {
    e.className = 'cd-num' + (phase === 'waiting' && urgent ? ' urgent' : phase === 'waiting' ? '' : ' ' + phase);
  });
}

function renderList(snapshot, now) {
  const container = document.getElementById('examList');
  if (!container) return;
  if (snapshot.exams.length === 0) {
    container.innerHTML = '<div class="empty">暂无考试</div>';
    return;
  }
  container.innerHTML = snapshot.exams.map(ex => {
    const { phase, parts, urgent } = getExamProgress(ex, now);
    const cdText = phase === 'waiting'
      ? '剩 ' + pad(parts.hrs) + ':' + pad(parts.mins) + ':' + pad(parts.secs)
      : phase === 'running'
        ? '已考 ' + pad(parts.hrs) + ':' + pad(parts.mins) + ':' + pad(parts.secs)
        : '已结束';
    const cdCls = phase === 'waiting' ? (urgent ? 'urgent' : '') : phase;
    const activeClass = snapshot.target && ex.id === snapshot.target.id ? 'active' : '';
    return `<div class="exam-item ${activeClass}">
      <div class="exam-info">
        <div class="exam-name">${escapeHtml(ex.name)}</div>
        <div class="exam-time">${fmtDT(ex.start)} — ${fmtDT(ex.end)}</div>
      </div>
      <div class="exam-cd ${cdCls}">${cdText}</div>
      <mdui-button-icon class="del-btn" data-id="${escapeHtml(String(ex.id))}" icon="delete_outline" title="删除"></mdui-button-icon>
    </div>`;
  }).join('');
}

function render() {
  const now = Date.now();
  const snapshot = createExamSnapshot(now);
  renderMain(snapshot);
  renderList(snapshot, now);
  if (focusMode.active) renderFocus(snapshot, now);
}

let countdownRenderTimer = null;
function scheduleCountdownRender() {
  clearTimeout(countdownRenderTimer);
  if (document.hidden) return;
  countdownRenderTimer = setTimeout(() => {
    render();
    scheduleCountdownRender();
  }, 1000 - (Date.now() % 1000));
}

document.addEventListener('visibilitychange', () => {
  if (document.hidden) {
    clearTimeout(countdownRenderTimer);
    return;
  }
  render();
  scheduleCountdownRender();
});

/* =========================================================
   一镜到底：计划管理页
   ========================================================= */
(function initMorph() {
  const openBtn = document.getElementById('openPlanBtn');
  const closeBtn = document.getElementById('planCloseBtn');
  const overlay = document.getElementById('planPageOverlay');
  const content = overlay.querySelector('.plan-page-content');
  const morphLayer = document.getElementById('morphLayer');

  if (!openBtn || !overlay) return;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DURATION = prefersReducedMotion ? 0 : 380;
  const RADIUS_TAIL = prefersReducedMotion ? 0 : 150;
  const RADIUS_DELAY = prefersReducedMotion ? 0 : 40;
  const RADIUS_HOLD = prefersReducedMotion ? 0 : 24;
  const RADIUS_LEAD = prefersReducedMotion ? 0 : 45;
  const FADE = prefersReducedMotion ? 0 : 40;
  const EASING = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const FALLBACK_COLOR = '#036C6D';

  let morphState = 'idle';
  let animToken = 0;
  let radiusTimer = null;

  function getButtonColor() {
    const cs = getComputedStyle(openBtn);
    let bg = cs.backgroundColor;
    if (!bg || bg === 'transparent' || bg === 'rgba(0, 0, 0, 0)') {
      const primary = getComputedStyle(document.body).getPropertyValue('--mdui-color-primary').trim();
      bg = primary ? (primary.startsWith('rgb') ? primary : `rgb(${primary})`) : FALLBACK_COLOR;
    }
    return bg;
  }
  function getSurfaceColor() {
    const raw = getComputedStyle(document.body).getPropertyValue('--mdui-color-surface').trim();
    if (!raw) return '#ffffff';
    return raw.startsWith('rgb') ? raw : `rgb(${raw})`;
  }
  function getButtonRadius(rect) {
    const cs = getComputedStyle(openBtn);
    const m = (cs.borderRadius || '0px').match(/([\d.]+)px/);
    let rpx = m ? parseFloat(m[1]) : 0;
    const maxR = Math.min(rect.width, rect.height) / 2;
    if (rpx > maxR) rpx = maxR;
    return rpx + 'px';
  }

  function setRect(el, rect, radius) {
    el.style.left = rect.left + 'px';
    el.style.top = rect.top + 'px';
    el.style.width = rect.width + 'px';
    el.style.height = rect.height + 'px';
    el.style.borderRadius = radius;
  }
  function sizeTransition() {
    return [
      `left ${DURATION}ms ${EASING}`, `top ${DURATION}ms ${EASING}`,
      `width ${DURATION}ms ${EASING}`, `height ${DURATION}ms ${EASING}`
    ].join(', ');
  }
  function radiusTransition(delay) { return `border-radius ${RADIUS_TAIL}ms ${EASING} ${delay}ms`; }
  function clearRadiusTimer() { if (radiusTimer) { clearTimeout(radiusTimer); radiusTimer = null; } }

  function waitSize(el) {
    return new Promise((resolve) => {
      if (DURATION === 0) { resolve(); return; }
      let done = false;
      const finish = () => { if (done) return; done = true; el.removeEventListener('transitionend', handler); resolve(); };
      const handler = (e) => { if (e.target === el && e.propertyName === 'width') finish(); };
      el.addEventListener('transitionend', handler);
      setTimeout(finish, DURATION + 150);
    });
  }

  async function openAnim() {
    if (morphState !== 'idle') return;
    const token = ++animToken;
    morphState = 'opening';
    clearRadiusTimer();

    const rect = openBtn.getBoundingClientRect();
    const bg = getButtonColor();
    const surface = getSurfaceColor();
    const radius = getButtonRadius(rect);
    const el = morphLayer;

    el.style.transition = 'none';
    el.style.display = 'block';
    el.style.background = bg;
    el.style.opacity = '0';
    setRect(el, rect, radius);
    void el.offsetWidth;

    await new Promise((r) => setTimeout(r, prefersReducedMotion ? 0 : 40));
    if (token !== animToken) return;

    el.classList.add('visible');
    el.style.transition = `opacity ${FADE}ms ease`;
    el.style.opacity = '1';
    await new Promise((r) => setTimeout(r, FADE));
    if (token !== animToken) return;

    el.style.transition = sizeTransition() + ', ' + radiusTransition(RADIUS_DELAY) + `, background-color ${DURATION}ms ${EASING}`;
    requestAnimationFrame(() => {
      if (token !== animToken) return;
      el.style.left = '0px';
      el.style.top = '0px';
      el.style.width = window.innerWidth + 'px';
      el.style.height = window.innerHeight + 'px';
      el.style.borderRadius = RADIUS_HOLD + 'px';
      el.style.background = surface;
    });

    radiusTimer = setTimeout(() => {
      if (token !== animToken) return;
      el.style.transition = radiusTransition(0);
      el.style.borderRadius = '0px';
    }, DURATION - RADIUS_LEAD);

    await waitSize(el);
    if (token !== animToken) return;

    morphState = 'open';
    document.body.classList.add('font-page-open');
    overlay.classList.add('active');
    overlay.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => { if (token === animToken) overlay.classList.add('content-in'); });

    el.style.transition = 'opacity 120ms ease';
    el.style.opacity = '0';
    setTimeout(() => {
      if (token !== animToken) return;
      el.style.display = 'none';
      el.classList.remove('visible');
    }, 140);
  }

  async function closeAnim() {
    if (morphState !== 'open') return;
    const token = ++animToken;
    morphState = 'closing';
    clearRadiusTimer();

    document.body.classList.remove('font-page-open');
    overlay.classList.remove('content-in');
    overlay.classList.remove('active');
    overlay.setAttribute('aria-hidden', 'true');

    const rect = openBtn.getBoundingClientRect();
    const bg = getButtonColor();
    const surface = getSurfaceColor();
    const radius = getButtonRadius(rect);
    const el = morphLayer;

    el.style.transition = 'none';
    el.style.display = 'block';
    el.style.background = surface;
    el.style.opacity = '1';
    el.style.left = '0px';
    el.style.top = '0px';
    el.style.width = window.innerWidth + 'px';
    el.style.height = window.innerHeight + 'px';
    el.style.borderRadius = '0px';
    void el.offsetWidth;

    el.classList.add('visible');
    el.style.transition = sizeTransition() + ', ' + radiusTransition(RADIUS_DELAY)
      + `, background-color ${DURATION}ms ${EASING}`;
    requestAnimationFrame(() => {
      if (token !== animToken) return;
      el.style.left = rect.left + 'px';
      el.style.top = rect.top + 'px';
      el.style.width = rect.width + 'px';
      el.style.height = rect.height + 'px';
      el.style.borderRadius = radius;
      el.style.background = bg;
    });

    await waitSize(el);
    if (token !== animToken) return;

    el.style.transition = 'opacity 100ms ease';
    el.style.opacity = '0';
    await new Promise((r) => setTimeout(r, 110));
    if (token !== animToken) return;

    el.style.display = 'none';
    el.style.transition = '';
    el.classList.remove('visible');
    morphState = 'idle';
  }

  openBtn.addEventListener('click', openAnim);
  closeBtn.addEventListener('click', closeAnim);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && morphState === 'open') closeAnim();
  });
})();

