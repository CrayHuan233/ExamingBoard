const focusMode = {
  active: false,
  main: 'clock',
};

const focusOverlay = document.getElementById('focusOverlay');
const focusCloseBtn = document.getElementById('focusCloseBtn');
const focusHint = document.getElementById('focusHint');
const focusPip = document.getElementById('focusPip');

const focusClockView = document.getElementById('focusClockView');
const focusCdView = document.getElementById('focusCdView');
const focusPipClockView = document.getElementById('focusPipClockView');
const focusPipCdView = document.getElementById('focusPipCdView');

function renderFocus(snapshot, now) {
  const d = new Date(now);
  document.getElementById('focusClockTime').textContent =
    pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
  document.getElementById('focusClockDate').textContent =
    d.getFullYear() + '/' + pad(d.getMonth()+1) + '/' + pad(d.getDate())
    + ' ' + ['日','一','二','三','四','五','六'][d.getDay()];

  const { target: exam, progress } = snapshot;
  const cdLabel = document.getElementById('focusCdLabel');
  const cdName = document.getElementById('focusCdName');
  const cdB = document.getElementById('focusCdB');
  const cdC = document.getElementById('focusCdC');
  const cdD = document.getElementById('focusCdD');
  const cdStatus = document.getElementById('focusStatus');

  if (!exam) {
    cdLabel.textContent = '倒计时';
    cdName.textContent = '暂无考试安排';
    cdName.className = 'focus-cd-name waiting';
    cdB.textContent = '00'; cdC.textContent = '00'; cdD.textContent = '00';
    cdStatus.textContent = '请添加考试';
    cdStatus.className = 'focus-status';
    [cdB, cdC, cdD].forEach(e => e.className = 'focus-cd-num');
  } else {
    const { phase, parts, label, status: statusText, urgent } = progress;
    cdName.textContent = exam.name;
    cdName.className = 'focus-cd-name ' + phase;
    cdLabel.textContent = label;
    cdB.textContent = pad(parts.hrs);
    cdC.textContent = pad(parts.mins);
    cdD.textContent = pad(parts.secs);
    [cdB, cdC, cdD].forEach(e => {
      e.className = 'focus-cd-num' + (phase === 'waiting' && urgent ? ' urgent' : phase === 'waiting' ? '' : ' ' + phase);
    });
    cdStatus.textContent = statusText;
    cdStatus.className = 'focus-status ' + phase;
  }

  const pipClockTime = document.getElementById('focusPipClockTime');
  const pipClockDate = document.getElementById('focusPipClockDate');
  const pipLabel = document.getElementById('focusPipLabel');
  const pipName = document.getElementById('focusPipName');
  const pipCd = document.getElementById('focusPipCd');
  const pipStatus = document.getElementById('focusPipStatus');

  pipClockTime.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
  pipClockDate.textContent = d.getFullYear() + '/' + pad(d.getMonth()+1) + '/' + pad(d.getDate());

  if (!exam) {
    pipLabel.textContent = '倒计时';
    pipName.textContent = '暂无考试安排';
    pipName.className = 'focus-pip-name waiting';
    pipCd.textContent = '--:--:--';
    pipCd.className = 'focus-pip-cd';
    pipStatus.textContent = '';
  } else {
    const { phase, parts, urgent, status: statusText } = progress;
    pipLabel.textContent = '倒计时';
    pipName.textContent = exam.name;
    pipName.className = 'focus-pip-name ' + phase;
    pipCd.textContent = pad(parts.hrs) + ':' + pad(parts.mins) + ':' + pad(parts.secs);
    pipCd.className = 'focus-pip-cd' + (phase === 'waiting' && urgent ? ' urgent' : phase === 'waiting' ? '' : ' ' + phase);
    pipStatus.textContent = statusText;
  }
}

function updateFocusLayout() {
  const isClockMain = focusMode.main === 'clock';
  focusClockView.style.display = isClockMain ? 'block' : 'none';
  focusCdView.style.display = isClockMain ? 'none' : 'block';
  focusPipClockView.style.display = isClockMain ? 'none' : 'block';
  focusPipCdView.style.display = isClockMain ? 'block' : 'none';
}

function renderCurrentFocus() {
  const now = Date.now();
  renderFocus(createExamSnapshot(now), now);
}

function enterFocus(mainView) {
  if (focusMode.active) {
    if (mainView !== focusMode.main) {
      focusMode.main = mainView;
      updateFocusLayout();
      renderCurrentFocus();
    }
    return;
  }
  focusMode.active = true;
  focusMode.main = mainView;
  document.body.classList.add('focus-mode');

  updateFocusLayout();
  renderCurrentFocus();

  focusOverlay.classList.add('active');
  focusOverlay.setAttribute('aria-hidden', 'false');
  focusPip.classList.add('active');
  focusCloseBtn.classList.add('active');
  focusHint.classList.add('active');
}

function exitFocus() {
  if (!focusMode.active) return;
  focusMode.active = false;
  document.body.classList.remove('focus-mode');
  focusOverlay.classList.remove('active');
  focusOverlay.setAttribute('aria-hidden', 'true');
  focusPip.classList.remove('active');
  focusCloseBtn.classList.remove('active');
  focusHint.classList.remove('active');
}

document.getElementById('cdClock').addEventListener('click', () => enterFocus('clock'));
document.getElementById('cdRow').addEventListener('click', () => enterFocus('countdown'));

focusPip.addEventListener('click', () => {
  if (!focusMode.active) return;
  focusMode.main = focusMode.main === 'clock' ? 'countdown' : 'clock';
  updateFocusLayout();
  renderCurrentFocus();
});

focusClockView.addEventListener('click', () => {
  if (!focusMode.active) return;
  focusMode.main = 'countdown';
  updateFocusLayout();
  renderCurrentFocus();
});
focusCdView.addEventListener('click', () => {
  if (!focusMode.active) return;
  focusMode.main = 'clock';
  updateFocusLayout();
  renderCurrentFocus();
});

focusCloseBtn.addEventListener('click', exitFocus);

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && focusMode.active) exitFocus();
});

focusOverlay.addEventListener('click', (e) => {
  if (e.target === focusOverlay) exitFocus();
});

