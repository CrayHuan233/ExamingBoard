<!DOCTYPE html>
<html lang="zh-CN" class="mdui-theme-auto">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no">
<meta name="renderer" content="webkit">
<title>考试看板</title>
<link rel="icon" type="image/svg+xml" href="https://fonts.gstatic.com/s/i/materialicons/schedule/v12/24px.svg">
<link rel="stylesheet" href="https://unpkg.com/mdui@2/mdui.css">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<script src="https://unpkg.com/mdui@2/mdui.global.js"></script>
<style>
/* ========== 字体 @font-face ========== */
@font-face {
  font-family: 'XiaolaiMono';
  src: url('./src/XiaolaiMono-Regular.subset.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

:root {
  --exam-background: #D2EFEE;
  --exam-card: #F7FDFC;
  --exam-accent: #036C6D;
  --exam-urgent: #C0282E;
  --exam-ended: #916B3D;
}
html.mdui-theme-dark {
  --exam-background: #163D3E;
  --exam-card: #214849;
  --exam-accent: #D2EFEE;
  --exam-urgent: #FF9A9F;
  --exam-ended: #C9A26B;
}
@media (prefers-color-scheme: dark) {
  html.mdui-theme-auto {
    --exam-background: #163D3E;
    --exam-card: #214849;
    --exam-accent: #D2EFEE;
    --exam-urgent: #FF9A9F;
    --exam-ended: #C9A26B;
  }
}

/* ========== 基础重置 ========== */
* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0; min-height: 100%;
  overflow-x: hidden;
  -webkit-tap-highlight-color: transparent;
}
body {
  font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  background: var(--exam-background);
  color: rgb(var(--mdui-color-on-surface));
  display: flex;
  justify-content: center;
  align-items: safe center;
  min-height: 100vh;
  padding: 80px 16px 0;
  overflow-y: auto;
}
body.font-page-open { overflow: hidden; }
body.focus-mode { overflow: hidden; }

/* ========== 顶栏 ========== */
.app-top-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 900;
  height: 64px;
  align-items: center;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(14px) saturate(1.2);
  -webkit-backdrop-filter: blur(14px) saturate(1.2);
  color: #036C6D;
}
.app-top-bar mdui-top-app-bar-title {
  color: #036C6D;
  height: 29px;
  font-size: 19px;
  line-height: 29px;
  align-self: center;
}
.app-top-bar .brand {
  height: 29px;
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}
.app-top-bar .brand-logo,
.app-top-bar mdui-top-app-bar-title {
  position: relative;
  top: 0;
}
.top-bar-actions {
  display: flex;
  align-items: center;
  gap: 2px;
  margin-right: 6px;
}
.brand-logo {
  width: auto;
  height: 29px;
  object-fit: contain;
  margin-left: 12px;
  margin-right: 8px;
  border-radius: 6px;
  align-self: center;
}

/* ========== 主页面布局 ========== */
.app {
  width: 100%;
  max-width: 1120px;
  margin: 0 auto;
}
.page { display: none; }
.page.active { display: block; }

/* ========== 卡片 ========== */
.card {
  background: var(--exam-card);
  border-radius: 24px;
  padding: 18px 24px 16px;
  box-shadow: 0 4px 20px rgba(0,0,0,.04), 0 1px 3px rgba(0,0,0,.04);
  margin-bottom: 18px;
  position: relative;
}
#dashboardPage .card { margin-bottom: 0; }
.title {
  font-size: 14px;
  letter-spacing: 3px;
  text-align: center;
  color: rgb(var(--mdui-color-on-surface-variant));
  margin-bottom: 6px;
}

/* =========================================================
   时间显示区域 —— 应用 XiaolaiMono 字体
   ========================================================= */
.time-font {
  font-family: 'XiaolaiMono', 'Consolas', 'Menlo', monospace;
  font-variant-numeric: tabular-nums;
}

.now-time {
  font-size: 48px;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  text-align: center;
  color: rgb(var(--mdui-color-on-surface));
  line-height: 1.15;
  cursor: pointer;
  transition: transform .2s, opacity .2s;
  font-family: 'XiaolaiMono', 'Consolas', 'Menlo', monospace;
}
.now-time:active { transform: scale(.97); }
.now-date {
  font-size: 13px;
  color: rgb(var(--mdui-color-on-surface-variant));
  text-align: center;
  margin-top: 2px;
  margin-bottom: 22px;
}
.round-clock-wrap {
  display: flex;
  justify-content: center;
  margin: 10px 0 16px;
  cursor: pointer;
}
.round-clock {
  width: min(330px, 78vw);
  aspect-ratio: 1;
  display: block;
  border-radius: 50%;
  background: var(--exam-card);
  filter: drop-shadow(0 8px 14px rgba(15, 23, 42, .10));
}
.clock-face-border { fill: var(--exam-card); stroke: #333333; stroke-width: 5; }
html.mdui-theme-dark .clock-face-border { stroke: #d6d8dc; }
.clock-tick { stroke: #555555; stroke-width: 1.2; stroke-linecap: round; }
.clock-tick.major { stroke: #333333; stroke-width: 1.8; }
html.mdui-theme-dark .clock-tick { stroke: #aab1bb; }
html.mdui-theme-dark .clock-tick.major { stroke: #d6d8dc; }
.clock-number {
  fill: #333333;
  font-size: 31px;
  font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  text-anchor: middle;
  dominant-baseline: middle;
}
html.mdui-theme-dark .clock-number { fill: #dfe3e8; }
.clock-date {
  fill: rgb(var(--mdui-color-on-surface-variant));
  font-size: 16px;
  text-anchor: middle;
  dominant-baseline: middle;
}
.clock-hour { stroke: #000000; stroke-width: 7; stroke-linecap: round; }
.clock-minute { stroke: #000000; stroke-width: 5; stroke-linecap: round; }
.clock-second { stroke: #C0282E; stroke-width: 2; stroke-linecap: round; }
html.mdui-theme-dark .clock-hour { stroke: #edf0f3; }
html.mdui-theme-dark .clock-minute { stroke: #edf0f3; }
.clock-pin-outer { fill: var(--exam-card); stroke: #C0282E; stroke-width: 2; }
.divider {
  height: 1px;
  background: rgb(var(--mdui-color-outline-variant));
  margin: 0 0 18px;
  opacity: .5;
}

/* ========== 倒计时区域 ========== */
.main-label {
  font-size: 13px;
  color: rgb(var(--mdui-color-on-surface-variant));
  text-align: center;
}
.main-name {
  font-size: 22px;
  font-weight: 700;
  text-align: center;
  margin: 6px 0 16px;
  min-height: 30px;
  color: rgb(var(--mdui-color-primary));
  transition: color .2s;
}
.main-name.waiting { color: rgb(var(--mdui-color-on-surface-variant)); }
.main-name.running { color: rgb(var(--mdui-color-primary)); }
.main-name.ended   { color: var(--exam-ended); }

.cd-row {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-bottom: 14px;
  cursor: pointer;
  transition: transform .2s, opacity .2s;
}
.cd-row:active { transform: scale(.98); }
.cd-unit {
  background: rgb(var(--mdui-color-surface-container-highest));
  border-radius: 16px;
  padding: 14px 10px 10px;
  min-width: 70px;
  text-align: center;
  flex: 1;
  max-width: 100px;
}
.cd-num {
  font-size: 32px;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  color: rgb(var(--mdui-color-primary));
  line-height: 1.1;
  font-family: 'XiaolaiMono', 'Consolas', 'Menlo', monospace;
}
.cd-num.urgent  { color: var(--exam-urgent); }
.cd-num.running { color: rgb(var(--mdui-color-primary)); }
.cd-num.ended   { color: var(--exam-ended); }
.cd-text {
  font-size: 12px;
  color: rgb(var(--mdui-color-on-surface-variant));
  margin-top: 5px;
}
.status {
  text-align: center;
  font-size: 13px;
  color: rgb(var(--mdui-color-on-surface-variant));
  margin-top: 6px;
}
.status.waiting { color: rgb(var(--mdui-color-primary)); }
.status.running { color: rgb(var(--mdui-color-primary)); }
.status.ended   { color: var(--exam-ended); }

/* ========== 按钮（使用 MDUI 默认圆角与高度） ========== */
.btn-primary {
  width: 100%;
  margin-top: 20px;
}

/* ========== 计划管理页 ========== */
.plan-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}
.back-btn {
  flex: 0 0 auto;
}
.page-title {
  font-size: 19px;
  font-weight: 700;
  color: rgb(var(--mdui-color-on-surface));
}
.form-row {
  display: flex;
  gap: 10px;
  margin-bottom: 12px;
}
.form-row mdui-select { flex: 1; width: 100%; }
.form-row mdui-text-field { flex: 1; }
.datetime-field-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
  cursor: pointer;
}
.datetime-field-wrap mdui-text-field { width: 100%; }
.datetime-field-wrap:not(.has-value) mdui-text-field::part(input) {
  color: transparent;
  -webkit-text-fill-color: transparent;
}
.datetime-placeholder {
  position: absolute;
  top: 50%;
  left: 16px;
  z-index: 1;
  transform: translateY(-50%);
  color: rgb(var(--mdui-color-on-surface-variant));
  opacity: .62;
  font-size: 16px;
  line-height: 1;
  width: calc(100% - 48px);
  padding-right: 8px;
  pointer-events: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.datetime-field-wrap.has-value .datetime-placeholder { display: none; }
.subject-form-row {
  position: relative;
  z-index: 10;
}
.subject-picker {
  width: 100%;
  justify-content: flex-start;
  text-align: left;
}
.subject-picker::part(label) { color: rgb(var(--mdui-color-on-surface)); }
.subject-dropdown {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  width: 100%;
  z-index: 10000;
  display: none;
  padding: 8px;
  border: 1px solid rgb(var(--mdui-color-outline-variant));
  border-radius: 16px;
  background: rgb(var(--mdui-color-surface-container-high));
  box-shadow: 0 8px 24px rgba(0,0,0,.16);
}
.subject-dropdown.open { display: block; }
.subject-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
  width: 100%;
}
.subject-grid-button {
  min-height: 44px;
  border: 1px solid rgb(var(--mdui-color-outline-variant));
  border-radius: 12px;
  background: rgb(var(--mdui-color-surface-container));
  color: rgb(var(--mdui-color-on-surface));
  font-size: 20px;
  font-weight: 600;
  cursor: pointer;
  transition: transform .12s, background .12s, border-color .12s;
}
.subject-grid-button:hover {
  background: rgb(var(--mdui-color-surface-container-high));
  border-color: rgb(var(--mdui-color-primary));
}
.subject-grid-button:active { transform: scale(.96); }
.subject-grid-button.selected {
  color: rgb(var(--mdui-color-on-primary));
  background: rgb(var(--mdui-color-primary));
  border-color: rgb(var(--mdui-color-primary));
}
.subject-grid-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 6px;
}

.list-title {
  font-size: 16px;
  font-weight: 600;
  color: rgb(var(--mdui-color-on-surface));
  margin-bottom: 14px;
}
.empty {
  font-size: 13px;
  color: rgb(var(--mdui-color-on-surface-variant));
  text-align: center;
  padding: 20px 0;
}

/* 考试条目 */
.exam-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  background: rgb(var(--mdui-color-surface-container-low));
  border-radius: 16px;
  margin-bottom: 10px;
  border: 1px solid transparent;
  transition: border-color .2s, background .2s;
}
.exam-item.active {
  border-color: rgb(var(--mdui-color-primary));
  background: rgb(var(--mdui-color-surface-container));
}
.exam-info { flex: 1; min-width: 0; }
.exam-name {
  font-size: 15px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.exam-time {
  font-size: 12px;
  color: rgb(var(--mdui-color-on-surface-variant));
  margin-top: 3px;
}
.exam-cd {
  font-size: 13px;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  color: rgb(var(--mdui-color-on-surface-variant));
  white-space: nowrap;
  text-align: right;
  min-width: 110px;
  font-family: 'XiaolaiMono', 'Consolas', 'Menlo', monospace;
}
.exam-cd.urgent  { color: var(--exam-urgent); }
.exam-cd.running { color: rgb(var(--mdui-color-primary)); }
.exam-cd.ended   { color: var(--exam-ended); }
.del-btn {
  flex: 0 0 auto;
}

/* ========== 一镜到底层 ========== */
#morphLayer {
  position: fixed;
  z-index: 999997;
  overflow: hidden;
  pointer-events: none;
  opacity: 0;
  display: none;
  will-change: left, top, width, height, border-radius, opacity, background-color;
}
#morphLayer.visible { opacity: 1; }

/* 计划管理副页面容器 */
.plan-page-overlay {
  position: fixed;
  inset: 0;
  z-index: 999996;
  visibility: hidden;
  pointer-events: none;
  background: rgb(var(--mdui-color-surface));
  touch-action: none;
}
.plan-page-overlay.active {
  visibility: visible;
  pointer-events: auto;
}
.plan-page-content {
  position: absolute;
  inset: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
  opacity: 0;
  transition: opacity 160ms cubic-bezier(0.22, 1, 0.36, 1);
  padding: 20px 16px 80px;
}
.plan-page-overlay.content-in .plan-page-content { opacity: 1; }

.plan-inner {
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* ========== 焦点模式（点击放大） ========== */
.focus-overlay {
  position: fixed;
  inset: 0;
  z-index: 999989;
  background: var(--exam-background);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 220ms cubic-bezier(0.22, 1, 0.36, 1),
              visibility 0s linear 220ms;
}
.focus-overlay.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
              visibility 0s linear 0s;
}

.focus-main {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: min(92vw, 720px);
  max-height: 80vh;
  text-align: center;
  padding: 20px;
}

/* 焦点模式时钟 */
.focus-clock {
  font-size: clamp(56px, 16vw, 120px);
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  color: rgb(var(--mdui-color-on-surface));
  line-height: 1.1;
  white-space: nowrap;
  font-family: 'XiaolaiMono', 'Consolas', 'Menlo', monospace;
}
.focus-clock-date {
  font-size: clamp(14px, 2.5vw, 20px);
  color: rgb(var(--mdui-color-on-surface-variant));
  margin-top: 8px;
}

/* 焦点模式倒计时 */
.focus-cd-label {
  font-size: clamp(14px, 2.2vw, 18px);
  color: rgb(var(--mdui-color-on-surface-variant));
  margin-bottom: 8px;
}
.focus-cd-name {
  font-size: clamp(20px, 3.5vw, 32px);
  font-weight: 700;
  margin-bottom: 20px;
  color: rgb(var(--mdui-color-primary));
}
.focus-cd-name.waiting { color: rgb(var(--mdui-color-on-surface-variant)); }
.focus-cd-name.running { color: rgb(var(--mdui-color-primary)); }
.focus-cd-name.ended   { color: var(--exam-ended); }
.focus-cd-row {
  display: flex;
  justify-content: center;
  gap: clamp(8px, 2vw, 18px);
  flex-wrap: nowrap;
}
.focus-cd-unit {
  background: rgb(var(--mdui-color-surface-container-highest));
  border-radius: clamp(12px, 2vw, 20px);
  padding: clamp(12px, 2.5vw, 24px) clamp(8px, 1.8vw, 18px);
  min-width: clamp(60px, 12vw, 120px);
  text-align: center;
}
.focus-cd-num {
  font-size: clamp(28px, 7vw, 64px);
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  color: rgb(var(--mdui-color-primary));
  line-height: 1.1;
  font-family: 'XiaolaiMono', 'Consolas', 'Menlo', monospace;
}
.focus-cd-num.urgent  { color: var(--exam-urgent); }
.focus-cd-num.running { color: rgb(var(--mdui-color-primary)); }
.focus-cd-num.ended   { color: var(--exam-ended); }
.focus-cd-text {
  font-size: clamp(11px, 1.6vw, 15px);
  color: rgb(var(--mdui-color-on-surface-variant));
  margin-top: 4px;
}
.focus-status {
  margin-top: 16px;
  font-size: clamp(13px, 2vw, 17px);
  color: rgb(var(--mdui-color-on-surface-variant));
}
.focus-status.waiting { color: rgb(var(--mdui-color-primary)); }
.focus-status.running { color: rgb(var(--mdui-color-primary)); }
.focus-status.ended   { color: var(--exam-ended); }

/* 右上角小挂件 */
.focus-pip {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 999994;
  background: var(--exam-card);
  border-radius: 16px;
  padding: 12px 16px;
  box-shadow: 0 6px 24px rgba(0,0,0,.12), 0 2px 6px rgba(0,0,0,.06);
  cursor: pointer;
  transition: transform .12s cubic-bezier(0.22, 1, 0.36, 1),
              box-shadow .12s;
  user-select: none;
  max-width: 220px;
  opacity: 0;
  transform: scale(.85) translateY(-8px);
  visibility: hidden;
  pointer-events: none;
}
.focus-pip.active {
  opacity: 1;
  transform: scale(1) translateY(0);
  visibility: visible;
  pointer-events: auto;
}
.focus-pip:hover {
  transform: scale(1.04) translateY(0);
  box-shadow: 0 10px 30px rgba(0,0,0,.16), 0 3px 8px rgba(0,0,0,.08);
}
.focus-pip:active { transform: scale(.97); }
.focus-pip-label {
  font-size: 11px;
  color: rgb(var(--mdui-color-on-surface-variant));
  letter-spacing: 1px;
  margin-bottom: 2px;
}
.focus-pip-clock {
  font-size: 20px;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  color: rgb(var(--mdui-color-on-surface));
  line-height: 1.2;
  font-family: 'XiaolaiMono', 'Consolas', 'Menlo', monospace;
}
.focus-pip-date {
  font-size: 10px;
  color: rgb(var(--mdui-color-on-surface-variant));
  margin-top: 2px;
}
.focus-pip-name {
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180px;
  margin-bottom: 2px;
}
.focus-pip-name.waiting { color: rgb(var(--mdui-color-on-surface-variant)); }
.focus-pip-name.running { color: rgb(var(--mdui-color-primary)); }
.focus-pip-name.ended   { color: var(--exam-ended); }
.focus-pip-cd {
  font-size: 15px;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  color: rgb(var(--mdui-color-primary));
  white-space: nowrap;
  font-family: 'XiaolaiMono', 'Consolas', 'Menlo', monospace;
}
.focus-pip-cd.urgent  { color: var(--exam-urgent); }
.focus-pip-cd.running { color: rgb(var(--mdui-color-primary)); }
.focus-pip-cd.ended   { color: var(--exam-ended); }
.focus-pip-status {
  font-size: 11px;
  color: rgb(var(--mdui-color-on-surface-variant));
  margin-top: 2px;
}

/* 关闭按钮 */
.focus-close {
  position: fixed;
  top: 20px;
  left: 20px;
  z-index: 999995;
  opacity: 0;
  transform: scale(.85);
  visibility: hidden;
  pointer-events: none;
  transition: opacity .12s, transform .12s, visibility 0s linear .12s;
}
.focus-overlay.active ~ .focus-close.active {
  opacity: 1;
  transform: scale(1);
  visibility: visible;
  pointer-events: auto;
  transition: opacity .12s .06s, transform .12s .06s, visibility 0s linear 0s;
}

/* 提示文字 */
.focus-hint {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 999994;
  font-size: 12px;
  color: rgb(var(--mdui-color-on-surface-variant));
  background: rgb(var(--mdui-color-surface-container));
  padding: 8px 18px;
  border-radius: 999px;
